class Todo < Formula
  desc "Local-first task and project planner with a vim-style terminal UI"
  homepage "https://github.com/@REPOSITORY@"
  version "@VERSION@"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/todo-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@MAC_ARM@"
    else
      url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/todo-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@MAC_INTEL@"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/todo-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@LINUX_ARM@"
    else
      url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/todo-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@LINUX_INTEL@"
    end
  end

  def install
    bin.install "todo"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/todo --version")
    data = testpath/"tasks.sqlite3"
    system bin/"todo", "--database", data, "task", "add", "Brew smoke test"
    assert_match "Brew smoke test", shell_output("#{bin}/todo --database #{data} --json task list")
  end
end
